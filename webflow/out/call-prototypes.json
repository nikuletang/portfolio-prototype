[{"build_label": "prototypes", "parent_element_id": {"component": "6acc38231a0f9d9c6343f9d6", "element": "a4c1fddb-de9a-c2b9-053a-b2f76765c321"}, "creation_position": "append", "html": "<section class=\"dcw-section is-dark\" id=\"prototypes\"><div class=\"dcw-wrap\"><div class=\"dcw-head\"><div class=\"dcw-eyebrow is-on-dark\"><span class=\"dcw-eyebrow-num is-on-dark\">06</span>Final experience and prototypes</div><h2 class=\"dcw-h2 is-on-dark\">Three flows, prototyped in Figma</h2><div class=\"dcw-h2-bar\"></div><p class=\"dcw-lede is-on-dark\">Explore each prototype or browse the complete set of screens.</p></div><div class=\"dcw-flow\" id=\"flow-rap\"><div class=\"dcw-flow-head\"><h3 class=\"dcw-h3 is-on-dark\">Report a Problem</h3><div class=\"dcw-badge is-muted-dark\">Designed · tested in Sprint 3 · refined in Sprint 4</div></div><div class=\"dcw-flow-grid\"><div class=\"dcw-proto\"><div class=\"dcw-proto-stage\"><div class=\"dcw-mock is-poster\"><div class=\"dcw-mock-body\"><div class=\"dcw-mock-btn\"></div><div class=\"dcw-mock-btn-l\"></div><div class=\"dcw-mock-island\"></div><img class=\"dcw-mock-screen\" src=\"https://cdn.prod.website-files.com/68caf66283367e4c3b2f3706/6acc456fdd0c8e3018726091_dcw-ph-phone.png\" alt=\"Report a Problem landing page with Report a Problem Form, Track Your Report and Customer Service Form buttons.\" data-asset=\"final-rap-01-landing.png\" loading=\"lazy\"></div></div></div><a class=\"dcw-btn is-ghost-dark\" href=\"#\" data-figma-link=\"flow-rap\">Open prototype in Figma ↗</a><p class=\"dcw-proto-note\">Figma link to be added: select this button and set its link in the Settings panel.</p></div><div class=\"dcw-col\"><div class=\"dcw-steps\"><div class=\"dcw-step\"><div class=\"dcw-step-n\">1</div><div class=\"dcw-step-t\">Choose Report a Problem, Track Your Report, or Customer Service.</div></div><div class=\"dcw-step\"><div class=\"dcw-step-n\">2</div><div class=\"dcw-step-t\">Set the location by address, current location, or