dcw-ph-phone.png\" alt=\"Optional notifications: choose phone call or email for ticket updates and for questions from DC Water, then enter contact details.\" data-asset=\"final-rap-06-notifications.png\" loading=\"lazy\"></div></div><div class=\"dcw-fig-text is-xs is-on-dark\">06 · Notifications</div></div><div class=\"dcw-strip-item\"><div class=\"dcw-mock\"><div class=\"dcw-mock-body\"><div class=\"dcw-mock-btn\"></div><div class=\"dcw-mock-btn-l\"></div><div class=\"dcw-mock-island\"></div><img class=\"dcw-mock-screen\" src=\"https://cdn.prod.website-files.com/68caf66283367e4c3b2f3706/6acc456fdd0c8e3018726091_dcw-ph-phone.png\" alt=\"Review screen listing location, issue and photos, each with an Edit link.\" data-asset=\"final-rap-07-review.png\" loading=\"lazy\"></div></div><div class=\"dcw-fig-text is-xs is-on-dark\">07 · Review</div></div><div class=\"dcw-strip-item\"><div class=\"dcw-mock\"><div class=\"dcw-mock-body\"><div class=\"dcw-mock-btn\"></div><div class=\"dcw-mock-btn-l\"></div><div class=\"dcw-mock-island\"></div><img class=\"dcw-mock-screen\" src=\"https://cdn.prod.website-files.com/68caf66283367e4c3b2f3706/6acc456fdd0c8e3018726091_dcw-ph-phone.png\" alt=\"Thank-you screen with ticket number #21-00541774 and buttons to view ticket status, report another problem or share.\" data-asset=\"final-rap-08-submitted.png\" loading=\"lazy\"></div></div><div class=\"dcw-fig-text is-xs is-on-dark\">08 · Submitted</div></div><div class=\"dcw-strip-item\"><div class=\"dcw-mock\"><div class=\"dcw-mock-body\"><div class=\"dcw-mock-btn\"></div><div class=\"dcw-mock-btn-l\"></div><div class=\"dcw-mock-island\"></div><img class=\"dcw-mock-screen\" src=\"https://cdn.prod.website-files.com/68caf66283367e4c3b2f3706/6acc456fdd0c8e3018726091_dcw-ph-phone.png\" alt=\"Track Your Report screen with a ticket number field and help text.\" data-asset=\"final-rap-09-track-your-report.png\" loading=\"lazy\"></div></div><div class=\"dcw-fig-text is-xs is-on-dark\">09 · Track your report</div></div><div class=\"dcw-strip-item\"><div class=\"dcw-mock\"><div class=\"dcw-mock-body\"><div class=\"dcw-mock-btn\"></div><div class=\"dcw-mock-btn-l\"></div><div class=\"dcw-mock-island\"></div><img class=\"dcw-mock-screen\" src=\"https://cdn.prod.website-files.com/68caf66283367e4c3b2f3706/6acc456fdd0c8e3018726091_dcw-ph-phone.png\" alt=\"Ticket status showing &#x27;Ticket Opened&#x27;, next steps and case history.\" data-asset=\"final-rap-10-ticket-opened.png\" loading=\"lazy\"></div></div><div class=\"dcw-fig-text is-xs is-on-dark\">10 · Ticket opened</div></div><div class=\"dcw-strip-item\"><div class=\"dcw-mock\"><div class=\"dcw-mock-body\"><div class=\"dcw-mock-btn\"></div><div class=\"dcw-mock-btn-l\"></div><div class=\"dcw-mock-island\"></div><img class=\"dcw-mock-screen\" src=\"https://cdn.prod.website-files.com/68caf66283367e4c3b2f3706/6acc456fdd0c8e3018726091_dcw-ph-phone.png\" alt=\"Closed ticket: &#x27;Your case has been resolved&#x27; with a five-star rating and a Leave feedback button.\" data-asset=\"final-rap-11-ticket-closed.png\" loading=\"lazy\"></div></div><div class=\"dcw-fig-text is-xs is-on-dark\">11 · Ticket closed</div></div><div class=\"dcw-strip-item\"><div class=\"dcw-mock\"><div class=\"dcw-mock-body\"><div class=\"dcw-mock-btn\"></div><div class=\"dcw-mock-btn-l\"></div><div class=\"dcw-mock-island\"></div><img class=\"dcw-mock-screen\" src=\"https://cdn.prod.website-files.com/68caf66283367e4c3b2f3706/6acc456fdd0c8e3018726091_dcw-ph-phone.png\" alt=\"Closed ticket after rating: five filled stars and &#x27;Thank you for rating your experience!&#x27;\" data-asset=\"final-rap-12-rated.png\" loading=\"lazy\"></div></div><div class=\"dcw-fig-text is-xs is-on-dark\">12 · Experience rated</div></div><div class=\"dcw-strip-item\"><div class=\"dcw-mock\"><div class=\"dcw-mock-body\"><div class=\"dcw-mock-btn\"></div><div class=\"dcw-mock-btn-l\"></div><div class=\"dcw-mock-island\"></div><img class=\"dcw-mock-screen\" src=\"https: